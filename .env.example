# Required: Claude API key
ANTHROPIC_API_KEY=

# Database (defaults to a local SQLite file). docker-compose sets this to its Postgres.
# DATABASE_URL=postgresql://user:pass@host:5432/adpress

# Models: the large model writes kits and ads; the small model reviews them.
# ADPRESS_WRITE_MODEL=claude-opus-5
# ADPRESS_CHECK_MODEL=claude-haiku-4-5
# Effort for the write model: low | medium | high | xhigh | max
# ADPRESS_WRITE_EFFORT=medium
# Set to 0 to skip the AI review pass (code checks always run)
# ADPRESS_LLM_REVIEW=1

# Website import
# ADPRESS_FETCH_MAX_PAGES=10
# ADPRESS_FETCH_TIMEOUT=30
# ADPRESS_USER_AGENT=AdpressBot/1.0 (+https://adpress.app/bot)

# Sign-in sessions last this many days
# ADPRESS_TOKEN_TTL_DAYS=30
